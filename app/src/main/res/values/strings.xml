    <!-- SFI, K and A explained (tap on the box); K follows the scale of IndexScales (NOAA) -->
    <string name="propagation_sfi_title">Solar Flux Index (SFI)</string>
    <string name="propagation_sfi_dialog">Measures 10.7 cm solar radio emissions. SFI &gt; 90/120 enhances upper HF bands (15m–10m) during daylight hours.</string>
    <string name="propagation_k_title">Planetary K-Index</string>
    <string name="propagation_k_dialog">Geomagnetic activity index (0–9). K 0–3: quiet; K 4: active; K 5 and above: geomagnetic storm (NOAA scale), with more absorption on HF.</string>
    <string name="propagation_a_title">Planetary A-Index</string>
    <string name="propagation_a_dialog">Daily average geomagnetic activity index (0–400). Values above 15 indicate geomagnetic instability.</string>

    <!-- The offline estimate for the ten HF bands: calculated on the phone, not N0NBH data -->
    <string name="estimate_title">Offline estimate · 10 bands</string>
    <string name="hf_band_title" translatable="false">%1$d m · %2$s</string>
    <string name="estimate_level">Estimate: %1$s</string>
    <string name="band_now_twilight">It is twilight at the station now.</string>
    <string name="estimate_no_position">Without a position (locator or GPS), day and night at the station are not known, so there is no estimate.</string>
    <string name="estimate_no_data">N0NBH gave no SFI or K index, so there is no estimate.</string>
    <string name="estimate_source">Offline estimate, calculated on the phone from SFI and K (N0NBH) and the Sun at the station. It is not a value published by N0NBH.</string>
    <string name="band_160m_dialog">Night and twilight band. Severe daytime D-layer absorption.</string>
    <string name="band_80m_dialog">Night and twilight band. Heavy daytime absorption, excellent night DX.</string>
    <string name="band_60m_dialog">Transition band. Moderate daytime absorption, reliable night F2 reflection.</string>
    <string name="band_40m_dialog">Local/NVIS by day, regional and DX by night and twilight.</string>
    <string name="band_30m_dialog">Open nearly 24/7. Low D-layer absorption, excellent at twilight.</string>
    <string name="band_20m_dialog">Primary workhorse HF band. Open daytime and twilight; night depends on SFI.</string>
    <string name="band_17m_dialog">Daytime and twilight band. Requires moderate F2 ionization.</string>
    <string name="band_15m_dialog">Daytime band. Highly responsive to solar flux (SFI ≥ 90).</string>
    <string name="band_12m_dialog">Daytime band. Opens near solar noon when SFI ≥ 110.</string>
    <string name="band_10m_dialog">Daytime band. Requires strong solar ionization near solar noon (SFI ≥ 120).</string>
